APP_ID=<Discord bot app id>
SERVER_ID=<Discord server to register command to>
DISCORD_TOKEN=<Discord api token>
PUBLIC_KEY=<Discord bot public key>
GOOGLE_CLIENT_EMAIL=<Google API service account email>
GOOGLE_PRIVATE_KEY=<Google API private key (should be quoted because of newlines)>
GOOGLE_SHEET_ID=<Google sheet for the fish tracking data target>
